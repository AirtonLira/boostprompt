# Endpoint compatível com a API OpenAI (LiteLLM, OpenRouter, vLLM, etc.).
# `LLM_BASE_URL` e `LLM_API_KEY` são os nomes preferidos.
LLM_PROVIDER=litellm
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=token-do-provedor

# Chave da Exa usada pela pesquisa da CLI/TUI (opcional).
EXA_API_KEY=

# Compatibilidade com arquivos .env já existentes do LiteLLM:
# LITELLM_BASE_URL=http://localhost:4000/v1
# API_KEY=token-do-provedor
# Para chamar a OpenAI diretamente, LLM_BASE_URL pode ser omitida e
# OPENAI_API_KEY (ou LLM_API_KEY) deve ser definido.

# Caminho do banco DuckDB (opcional, default: data/boostprompt.db)
DUCKDB_PATH=data/boostprompt.db
